{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"ES2024"
		],
		"types": [],
		"module": "nodenext",
		"noEmit": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"exactOptionalPropertyTypes": false,
		"useUnknownInCatchVariables": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"exclude": [
		"node_modules/**",
		"monaco-editor-playground/**",
		"builtin/**",
		// The smoke driver is an extension source: it targets the extension host
		// with CommonJS and the `vscode` types, not this project, which is
		// nodenext build tooling. It is compiled by the smoke that loads it.
		"unigma/agent-session-driver/**",
		"vite/**"
	]
}
