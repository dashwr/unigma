diff --git a/packages/opencode/src/service.ts b/packages/opencode/src/service.ts
new file mode 100644
index 0000000000..e2703559af
--- /dev/null
+++ b/packages/opencode/src/service.ts
@@ -0,0 +1,57 @@
+import { InstallationVersion } from "@opencode-ai/core/installation/version"
+
+const args = process.argv.slice(2)
+if (args[0] === "serve") args.shift()
+
+if (args.length === 1 && (args[0] === "--version" || args[0] === "-v")) {
+  process.stdout.write(`${InstallationVersion}\n`)
+} else {
+  const options = parseOptions(args)
+  const { Server } = await import("./server/server")
+  const listener = await Server.listen({ ...options, ui: false })
+
+  process.stdout.write(`opencode server listening on http://${listener.hostname}:${listener.port}\n`)
+
+  let stopping = false
+  const stop = async () => {
+    if (stopping) return
+    stopping = true
+    await listener.stop(true)
+    process.exit()
+  }
+
+  process.once("SIGINT", () => void stop())
+  process.once("SIGTERM", () => void stop())
+}
+
+function parseOptions(args: string[]) {
+  let hostname = "127.0.0.1"
+  let port = 0
+
+  for (let index = 0; index < args.length; index++) {
+    const arg = args[index]
+    const [name, inlineValue] = arg.split("=", 2)
+    if (name !== "--hostname" && name !== "--port") {
+      throw new Error(`Unsupported service option: ${arg}`)
+    }
+
+    const value = inlineValue ?? args[++index]
+    if (!value || value.startsWith("--")) {
+      throw new Error(`Missing value for ${name}`)
+    }
+
+    if (name === "--hostname") {
+      if (value !== "127.0.0.1") throw new Error("Service hostname must be 127.0.0.1")
+      hostname = value
+      continue
+    }
+
+    const parsed = Number(value)
+    if (!Number.isSafeInteger(parsed) || parsed < 0 || parsed > 65535) {
+      throw new Error("Service port must be an integer between 0 and 65535")
+    }
+    port = parsed
+  }
+
+  return { hostname, port }
+}
