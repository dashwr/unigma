    "list.focusOutline": "#f0abfc",
    "list.hoverBackground": "#170d24",
    "list.hoverForeground": "#ffffff",
    "list.highlightForeground": "#bfffe0",
    "list.errorForeground": "#ff8a8a",
    "list.warningForeground": "#ffd580",
