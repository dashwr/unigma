  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#d6b3ff" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#ffb3f3" } },
    { "scope": ["constant", "constant.numeric", "variable.language"], "settings": { "foreground": "#9bdcff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#d6b3ff" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#ff8bf2" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#bfffe0" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#9bdcff" } },
    { "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#ffb3f3", "fontStyle": "bold" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff8a8a" } }
  ],
  "semanticTokenColors": {
    "variable": "#ffffff",
    "parameter": "#ffffff",
    "property": "#9bdcff",
    "function": "#d6b3ff",
    "method": "#d6b3ff",
    "class": "#bfffe0",
    "type": "#bfffe0",
    "string": "#ffb3f3",
    "number": "#9bdcff",
    "keyword": "#ff8bf2",
    "comment": "#d6b3ff"
  }
}
