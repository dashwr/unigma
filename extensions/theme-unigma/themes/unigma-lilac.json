  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6f6788" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#9d1150" } },
    { "scope": ["constant", "constant.numeric", "variable.language"], "settings": { "foreground": "#1d4ed8" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#6d28d9" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#5b21b6" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#137a45" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#1b1729" } },
    { "scope": ["invalid"], "settings": { "foreground": "#be1a67" } }
  ]
