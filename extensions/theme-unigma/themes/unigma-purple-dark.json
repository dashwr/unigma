  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#b2a8c6" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#f9a8d4" } },
    { "scope": ["constant", "constant.numeric", "variable.language"], "settings": { "foreground": "#7dd3fc" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#c4b5fd" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#a78bfa" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#4ade80" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#efeff4" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f472b6" } }
  ]
