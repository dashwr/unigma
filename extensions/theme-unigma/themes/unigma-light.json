    "charts.blue": "#175cd3",
    "charts.green": "#087443",
    "charts.red": "#b42318",
    "charts.yellow": "#8a5a00"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#756980" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#a21caf" } },
    { "scope": ["constant", "constant.numeric", "variable.language"], "settings": { "foreground": "#175cd3" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#6d28d9" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#a21caf" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#5b21b6" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#211a2b" } },
    { "scope": ["invalid"], "settings": { "foreground": "#b42318" } }
  ]
}
