    "charts.blue": "#93c5fd",
    "charts.green": "#86efac",
    "charts.red": "#ff9b9b",
    "charts.yellow": "#fde68a"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a596bd" } },
    { "scope": ["string", "constant.character"], "settings": { "foreground": "#f0abfc" } },
    { "scope": ["constant", "constant.numeric", "variable.language"], "settings": { "foreground": "#93c5fd" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#d8b4fe" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#e879f9" } },
    { "scope": ["entity.name.type", "support.type", "entity.name.class"], "settings": { "foreground": "#c4b5fd" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#f1eaff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff9b9b" } }
  ]
}
